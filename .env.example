# ─────────────────────────────────────────────────────────────
#  Al Manhaj Stationery — variables d'environnement
#  Copiez ce fichier en « .env.local » pour le développement local.
#  Sur Vercel : Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# 1) Base de données Neon (obligatoire en production)
#    Neon → Dashboard → Connect → « Connection string » (pooled / -pooler)
#    Exemple : postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 2) Mot de passe du panneau d'administration (obligatoire)
#    C'est le mot de passe unique pour accéder à /admin
ADMIN_PASSWORD=

# 3) Secret de signature des cookies de session (fortement recommandé)
#    Générez-en un avec :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#    Si absent, une clé dérivée de ADMIN_PASSWORD est utilisée (fonctionne, mais reste à changer
#    de mot de passe pour invalider les sessions).
AUTH_SECRET=

# 4) Durée de la session admin en heures (optionnel, défaut : 12)
ADMIN_SESSION_HOURS=12

# 5) Nom affiché dans le panneau d'administration (optionnel)
NEXT_PUBLIC_SITE_NAME=شركة المنهج للقرطاسية
